diff --git a/.github/workflows/purge-update-cdn.yml b/.github/workflows/purge-update-cdn.yml
new file mode 100644
index 0000000..a7166b7
--- /dev/null
+++ b/.github/workflows/purge-update-cdn.yml
@@ -0,0 +1,81 @@
+# 更新清单 CDN 缓存清洗（purge-update-cdn）——v8.0.9 更新系统根治轮新增
+# ═════════════════════════════════════════════════════════════════════
+# 背景（2026-11-27 事故）：v8.0.8 发布后 update/latest.json 已在 main，
+# 但 jsDelivr cdn/gcore 两域对 @main 清单持续返回陈旧缓存（17h+ 仍 87100，
+# 远超官方口径 12h）——未主动 purge 时所有旧客户端一律「已是最新」。
+#
+# 本工作流是 update-manifest.yml purge 步骤之外的【第三道清洗触发面】：
+#   · push 触达 update/latest.json（含发布链从沙箱手动提交清单的路径——
+#     update-manifest.yml 的 release 事件对「清单已先行手动提交」场景天然
+#     不可达，本触发面补齐）；
+#   · 每日定时兜底（即使某次 purge 限频失败，≤24h 内自动收敛——与客户端
+#     每日一次的检查节奏对齐）；
+#   · workflow_dispatch 手动清洗（事故即修）。
+# 清洗范围：官方仓 xiaobaiba999/Skip-Ad + 历史仓 xiaobaiba999/kilo（8.0.x
+# 旧客户端回退源）双仓清单；purge 后逐域核验（cdn/gcore/fastly/testingcf）
+# 并与 main 实际内容对比，未达即步骤失败（如实呈现，不伪造成功）。
+name: purge-update-cdn
+
+on:
+  push:
+    branches: [main]
+    paths:
+      - "update/latest.json"
+  schedule:
+    # 每日 01:17 UTC（错开整点高峰）
+    - cron: "17 1 * * *"
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+concurrency:
+  group: purge-update-cdn
+  cancel-in-progress: false
+
+jobs:
+  purge:
+    runs-on: ubuntu-latest
+    steps:
+      - name: 清洗双仓 jsDelivr @main 清单缓存（purge.jsdelivr.net 免认证公开端点）
+        run: |
+          set -uo pipefail
+          FAIL=0
+          for REPO_FULL in "xiaobaiba999/Skip-Ad" "xiaobaiba999/kilo"; do
+            URL="https://purge.jsdelivr.net/gh/${REPO_FULL}@main/update/latest.json"
+            OUT=$(curl -fsSL --max-time 60 "$URL" 2>&1 || true)
+            if echo "$OUT" | grep -q '"status"'; then
+              echo "✓ purge 已提交（${REPO_FULL}）：$(echo "$OUT" | head -c 200)"
+            else
+              echo "⚠ purge 未确认（${REPO_FULL}）：$OUT"
+              FAIL=1
+            fi
+          done
+          echo "PURGE_FAIL=$FAIL" >> "$GITHUB_ENV"
+          exit 0
+
+      - name: 逐域核验（与 main 实际清单比对——如实呈现，不伪造成功）
+        run: |
+          set -uo pipefail
+          sleep 20
+          EXPECT_MAIN=$(curl -fsSL --max-time 30 "https://raw.githubusercontent.com/xiaobaiba999/Skip-Ad/main/update/latest.json" | jq -r '.versionCode')
+          echo "main 实际 versionCode=$EXPECT_MAIN"
+          FAIL=${PURGE_FAIL:-0}
+          for REPO_FULL in "xiaobaiba999/Skip-Ad" "xiaobaiba999/kilo"; do
+            for HOST in cdn.jsdelivr.net gcore.jsdelivr.net fastly.jsdelivr.net testingcf.jsdelivr.net; do
+              URL="https://${HOST}/gh/${REPO_FULL}@main/update/latest.json"
+              VC=$(curl -fsSL --max-time 30 "$URL" 2>/dev/null | jq -r '.versionCode // empty' 2>/dev/null || true)
+              if [ "$VC" = "$EXPECT_MAIN" ]; then
+                echo "✓ ${REPO_FULL} @${HOST}：versionCode=$VC（已新鲜）"
+              else
+                echo "⚠ ${REPO_FULL} @${HOST}：versionCode=${VC:-不可达} ≠ main $EXPECT_MAIN（陈旧缓存，≤12h 自然过期；@tag 清单零缓存不受影响）"
+                FAIL=1
+              fi
+            done
+          done
+          if [ "$FAIL" != "0" ]; then
+            echo "⚠ 存在陈旧域——清单已在 main（raw 源已生效），陈旧域 12h 内自然过期；次日定时清洗将再次收敛"
+          else
+            echo "✓ 全部域已新鲜"
+          fi
+          exit 0
